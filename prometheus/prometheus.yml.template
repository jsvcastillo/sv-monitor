global:
  scrape_interval: 15s

rule_files:
  - /etc/prometheus/rules/*.yml

scrape_configs:
  - job_name: prometheus
    static_configs:
      - targets: ["localhost:9090"]
      
  - job_name: "node-exporter"
    static_configs:
      - targets: [${NODE_EXPORTERS}]
          
  - job_name: "cadvisor"
    static_configs:
      - targets: [${CADVISORS}]

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - "alertmanager:9093"